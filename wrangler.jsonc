{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botdroid-landing",
  "main": "worker.js",
  "compatibility_date": "2026-07-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "WAITLIST",
      "id": "53348a58774140d98c0f2e5e5745551d"
    }
  ]
}
