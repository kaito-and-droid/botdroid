---
import { Icon } from '@astrojs/starlight/components';

interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const base = lang === 'vi' ? '/vi' : '';
const PLAY = 'https://play.google.com/store/apps/details?id=com.kaito.botdroid';

type IconName = 'laptop' | 'seti:lock' | 'puzzle' | 'comment-alt' | 'clock' | 'random';
const t = {
	en: {
		featuresTitle: 'Everything a bot needs, in one app',
		features: [
			{ icon: 'comment-alt', title: 'One in-app chat for all your bots', text: 'Talk to every bot and the built-in Assistant in one place. No messenger needed.' },
			{ icon: 'laptop', title: 'Runs on your phone', text: 'A foreground service keeps bots online with the screen off, and restarts them after a reboot.' },
			{ icon: 'seti:lock', title: 'Your keys, encrypted', text: 'Tokens and API keys are stored with AES-256-GCM in the Android Keystore and never put in backups.' },
			{ icon: 'random', title: 'Any AI provider', text: 'OpenRouter, OpenAI, Gemini, Groq, NVIDIA, DeepSeek, xAI, Cloudflare, or any OpenAI-compatible endpoint.' },
			{ icon: 'comment-alt', title: 'Many channels per bot', text: 'One AI agent can answer on Telegram, Discord and Slack at the same time.' },
			{ icon: 'puzzle', title: 'Tools with MCP', text: 'Connect tool servers for live prices, travel search or blockchain data.' },
			{ icon: 'clock', title: 'Scheduled tasks', text: 'Let an agent send a morning summary or a weekly report on its own.' },
		] as { icon: IconName; title: string; text: string }[],
		chat: {
			title: 'Chat with all your bots in one place',
			items: [
				'Talk to any bot with @name.',
				'Run bot commands with /command, or try /price and /weather with no bot at all.',
				'Ask the built-in Assistant by just typing.',
				'Attach photos or files for AI bots that support them.',
			],
			rule: 'In Chat, everyone can use the Assistant, Python bots and template commands. AI bots need Pro (and their provider, key and model set up).',
			cta: 'Read the Chat guide',
		},
		stepsTitle: 'From install to running bot in three steps',
		steps: [
			{ title: 'Install & allow background', text: 'Exempt BotDroid from battery optimization so bots survive screen-off.' },
			{ title: 'Pick a template', text: 'Connect a messenger such as Telegram, Zalo or Discord with its bot token. AI bots also need a provider key.' },
			{ title: 'Tap Start', text: 'Message your bot in Chat or your messenger. Check live logs if anything goes wrong.' },
		],
		stepsCta: 'Follow the full guide',
		ctaTitle: 'Your next bot doesn’t need a server.',
		ctaText: 'Free to download. Start with a template in a few minutes.',
		ctaPlay: 'Get it on Google Play', ctaHelp: 'Need help?',
	},
	vi: {
		featuresTitle: 'Mọi thứ bot cần, trong một app',
		features: [
			{ icon: 'comment-alt', title: 'Một khung trò chuyện cho mọi bot', text: 'Trò chuyện với mọi bot và Trợ lý tích hợp ngay trong app. Không cần messenger.' },
			{ icon: 'laptop', title: 'Chạy trên điện thoại', text: 'Dịch vụ nền giữ bot online khi tắt màn hình, và tự chạy lại sau khi khởi động máy.' },
			{ icon: 'seti:lock', title: 'Key được mã hoá', text: 'Token và API key được lưu bằng AES-256-GCM trong Android Keystore và không bao giờ nằm trong bản sao lưu.' },
			{ icon: 'random', title: 'Mọi nhà cung cấp AI', text: 'OpenRouter, OpenAI, Gemini, Groq, NVIDIA, DeepSeek, xAI, Cloudflare hoặc bất kỳ endpoint tương thích OpenAI.' },
			{ icon: 'comment-alt', title: 'Nhiều kênh cho một bot', text: 'Một agent AI có thể trả lời trên Telegram, Discord và Slack cùng lúc.' },
			{ icon: 'puzzle', title: 'Công cụ qua MCP', text: 'Kết nối máy chủ công cụ để có giá trực tiếp, tìm chuyến đi hay dữ liệu blockchain.' },
			{ icon: 'clock', title: 'Tác vụ định kỳ', text: 'Để agent tự gửi bản tóm tắt buổi sáng hay báo cáo hằng tuần.' },
		] as { icon: IconName; title: string; text: string }[],
		chat: {
			title: 'Trò chuyện với mọi bot ở một nơi',
			items: [
				'Gọi bất kỳ bot nào bằng @tên.',
				'Chạy lệnh của bot bằng /lệnh, hoặc thử /price và /weather mà không cần bot.',
				'Hỏi Trợ lý tích hợp bằng cách cứ gõ.',
				'Đính kèm ảnh hoặc tệp cho bot AI có hỗ trợ.',
			],
			rule: 'Trong Trò chuyện, ai cũng dùng được Trợ lý, bot Python và lệnh mẫu. Bot AI cần Pro (và đã thiết lập nhà cung cấp, key, model).',
			cta: 'Xem hướng dẫn Trò chuyện',
		},
		stepsTitle: 'Từ lúc cài đến khi bot chạy chỉ ba bước',
		steps: [
			{ title: 'Cài & cho phép chạy nền', text: 'Bỏ tối ưu pin cho BotDroid để bot vẫn chạy khi tắt màn hình.' },
			{ title: 'Chọn một mẫu', text: 'Kết nối một ứng dụng nhắn tin như Telegram, Zalo hay Discord bằng token bot. Bot AI cần thêm key của nhà cung cấp.' },
			{ title: 'Nhấn Start', text: 'Nhắn tin cho bot trong Trò chuyện hoặc messenger. Xem log trực tiếp nếu có lỗi.' },
		],
		stepsCta: 'Xem hướng dẫn đầy đủ',
		ctaTitle: 'Bot tiếp theo của bạn không cần máy chủ.',
		ctaText: 'Tải miễn phí. Bắt đầu với một mẫu trong vài phút.',
		ctaPlay: 'Tải trên Google Play', ctaHelp: 'Cần trợ giúp?',
	},
}[lang];
---

<section class="bd-section not-content">
	<h2>{t.featuresTitle}</h2>
	<div class="features">
		{t.features.map((f) => (
			<article class="feature" data-reveal>
				<span class="ic"><Icon name={f.icon} size="1.4rem" /></span>
				<h3>{f.title}</h3>
				<p>{f.text}</p>
			</article>
		))}
	</div>
</section>

<section class="bd-section not-content chat-hl" data-testid="chat-highlight">
	<h2>{t.chat.title}</h2>
	<ul>
		{t.chat.items.map((i) => <li>{i}</li>)}
	</ul>
	<p class="rule">{t.chat.rule}</p>
	<a class="more" href={`${base}/guide/chat/`}>{t.chat.cta} →</a>
</section>

<section class="bd-section not-content">
	<h2>{t.stepsTitle}</h2>
	<ol class="steps">
		{t.steps.map((s, i) => (
			<li data-reveal>
				<span class="num">{i + 1}</span>
				<h3>{s.title}</h3>
				<p>{s.text}</p>
			</li>
		))}
	</ol>
	<a class="more" href={`${base}/guide/getting-started/`}>{t.stepsCta} →</a>
</section>

<section class="cta not-content" data-reveal>
	<h2>{t.ctaTitle}</h2>
	<p>{t.ctaText}</p>
	<div class="row">
		<a class="btn primary" href={PLAY} target="_blank" rel="noopener"><Icon name="mobile-android" />{t.ctaPlay}</a>
		<a class="btn ghost" href={`${base}/help/troubleshooting/`}>{t.ctaHelp}</a>
	</div>
</section>

<style>
	.chat-hl ul { margin: 0 0 1rem; padding-left: 1.2rem; color: var(--sl-color-gray-2); }
	.chat-hl .rule { margin-bottom: 1rem; overflow-wrap: anywhere; }
	.bd-section { margin-block: 4rem; }
	h2 { font-size: var(--sl-text-3xl); font-weight: 700; color: var(--sl-color-white); margin-bottom: 1.25rem; }
	h3 { font-size: var(--sl-text-lg); color: var(--sl-color-white); margin: 0.6rem 0 0.3rem; }
	p { margin: 0; color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
	.features { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
	.feature {
		padding: 1.25rem; border-radius: 1rem; border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-6);
		transition: transform 0.2s, border-color 0.2s;
	}
	.feature:hover { transform: translateY(-3px); border-color: var(--sl-color-accent); }
	.ic { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 0.75rem; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); }
	.steps { list-style: none; padding: 0; display: grid; gap: 1rem; counter-reset: s; }
	@media (min-width: 50rem) { .steps { grid-template-columns: repeat(3, 1fr); } }
	.steps li { position: relative; margin: 0; padding: 1.25rem; border-radius: 1rem; border: 1px dashed var(--sl-color-gray-4); }
	.num {
		display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%;
		background: #00e5c8; color: #04231f; font-weight: 800; font-family: var(--sl-font-mono);
	}
	.more { display: inline-block; margin-top: 1rem; color: var(--sl-color-accent-high); font-weight: 600; }
	.cta {
		margin-block: 4rem 2rem; padding: 2.5rem 1.5rem; text-align: center; border-radius: 1.5rem;
		background: radial-gradient(60% 120% at 50% 0%, rgb(0 229 200 / 0.22), transparent 70%), var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
	}
	.cta p { font-size: var(--sl-text-base); }
	.row { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.25rem; }
	.btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; border-radius: 0.75rem; font-weight: 600; text-decoration: none; }
	.btn.primary { background: #00e5c8; color: #04231f; }
	.btn.ghost { border: 1px solid var(--sl-color-gray-4); color: var(--sl-color-white); }
	[data-reveal] { transition: opacity 0.5s ease, transform 0.5s ease; }
	:global(.js-reveal) [data-reveal]:not(.shown) { opacity: 0; transform: translateY(14px); }
</style>

<script>
	// Fade sections in as they scroll into view. Without JS (or with reduced motion) they just show.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
		document.documentElement.classList.add('js-reveal');
		const io = new IntersectionObserver((entries) => entries.forEach((e) => {
			if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); }
		}), { threshold: 0.15 });
		document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
	}
</script>
